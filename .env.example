# Copie para .env e preencha

# Chave da API da Anthropic
ANTHROPIC_API_KEY=

# Modelo Claude usado na classificação e nas extrações
MODEL_ID=claude-opus-5-5

# Profundidade de raciocínio: low | medium | high | xhigh | max. Vazio = padrão do modelo
LLM_EFFORT=

# Reexecuta em outro modelo as requisições recusadas pelo modelo principal.
# Deixe vazio para desligar (necessário em modelos que não aceitam o parâmetro)
LLM_FALLBACKS=default

# Idiomas do OCR do docling, como tags BCP-47 com o prefixo "iso:" (separados por vírgula)
OCR_LANG=iso:pt
